# Geopolitical Prediction Markets - Environment Configuration
# Copy this to .env and fill in your API keys

# ACLED (https://acleddata.com/register/)
ACLED_API_KEY=
ACLED_EMAIL=

# GDELT (no key required for v2 API)
# GDELT_BASE_URL is set in config defaults

# Sentinel Hub (https://www.sentinel-hub.com/)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# MarineTraffic (https://www.marinetraffic.com/en/ais-api-services)
MARINE_TRAFFIC_API_KEY=

# Twitter/X API (https://developer.twitter.com/)
TWITTER_BEARER_TOKEN=

# Database
DATABASE_URL=sqlite:///geopolitical_predictions.db

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Alert thresholds
ALERT_ESCALATION_THRESHOLD=0.7
ALERT_EMAIL=
